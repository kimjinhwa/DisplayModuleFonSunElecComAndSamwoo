-- ============================================================
-- Pack 3 terminator  (1.3.6.1.2.1.32.3)
-- GETNEXT after pack2CellNum (.32.2.15.0) returns this leaf.
-- Walk of pack2Value then leaves the subtree; no endOfMibView loop.
-- ============================================================

batMibWalkEnd OBJECT-TYPE
	SYNTAX		Integer32
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION	"Always 0. GETNEXT terminator after pack2Value. Not a battery pack."
	::= { pack3Value 1 }

batStatusWalkEnd OBJECT-TYPE
	SYNTAX		Integer32
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION	"Always 0. GETNEXT terminator after batStatus (sibling of .32)."
	::= { batCommon 33 }

batCommonWalkEnd OBJECT-TYPE
	SYNTAX		Integer32
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION	"Always 0. GETNEXT terminator after batCommon / mib-2."
	::= { mgmt 2 }

