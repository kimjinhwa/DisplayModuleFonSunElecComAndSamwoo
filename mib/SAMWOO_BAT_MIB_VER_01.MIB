-- SAMWOO lithium pack SNMP MIB for Display Module (Pack1 + Pack2)
-- OID tree matches firmware src/snmp_battery.cpp
--   pack1: 1.3.6.1.2.1.32.1
--   pack2: 1.3.6.1.2.1.32.2
-- Referenced from LithumeBAT_MIB_VER_01.MIB (IFTECH)
-- SNMPv2c community public, UDP 161, Integer32 leaf .0

SAMWOO-BAT-MIB DEFINITIONS ::= BEGIN
IMPORTS
	MODULE-IDENTITY, OBJECT-TYPE, Integer32, mgmt
		FROM SNMPv2-SMI;

samwooBatMIB MODULE-IDENTITY
	LAST-UPDATED	"202609021415Z"
	ORGANIZATION	"IFTECH / SunElec / Samwoo"
	CONTACT-INFO	"mvcjhkim@gmail.com"
	DESCRIPTION
		"Samwoo BMS display SNMP MIB. Two lithium packs.
		Values are raw register integers as served by the agent.
		Units: SOC/SOH %; capacity 0.1Ah; packV/current/temp 0.1;
		cell voltage mV; relays 0/1."
	REVISION	"202609021415Z"
	DESCRIPTION	"VER 01b — walk terminators after batStatus and batCommon."
	REVISION	"202609021330Z"
	DESCRIPTION	"VER 01a — pack3 walk terminator after pack2."
	REVISION	"202609021300Z"
	DESCRIPTION	"VER 01 — Pack1 + Pack2, firmware-aligned OIDs."
	::= { mgmt 1 }

batCommon	OBJECT IDENTIFIER ::= { mgmt 1 }
batStatus	OBJECT IDENTIFIER ::= { batCommon 32 }

pack1Value	OBJECT IDENTIFIER ::= { batStatus 1 }
pack2Value	OBJECT IDENTIFIER ::= { batStatus 2 }
pack3Value	OBJECT IDENTIFIER ::= { batStatus 3 }

